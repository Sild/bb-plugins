  "pluginSettings": {
    "bb-guide": {
      "introduction": false,
      "skills": true,
      "bbCli": true,
      "pluginAuthoring": true,
      "skillCreator": true,
      "submitPlugin": true
    },
    "connect": {
      "sendRemoteInstructions": true
    },
    "custom-instructions": {
      "instructions": ""
    },
    "provider-acp": {
      "customAgents": ""
    },
    "provider-claude-code": {
      "memoryEnabled": true,
      "subagentsDisabled": false,
      "workflowsDisabled": false,
      "chromeEnabled": true
    },
    "provider-codex": {
      "memoryEnabled": true,
      "subagentsDisabled": false
    },
    "provider-retry": {
      "maximumWait": "6 hours"
    },
    "push-notifications": {
      "mobileEnabled": true,
      "webEnabled": true,
      "desktopEnabled": true,
      "expoPushUrl": "https://exp.host/--/api/v2/push/send"
    }
  },
  "general": {
    "showKeyboardHints": true,
    "steerActiveThreadOnEnter": true,
    "showDiagnosticEvents": false,
    "providerOrder": [],
    "defaultProviderId": null,
    "streamerMode": false,
    "telemetryEnabled": true,
    "managedBranchPrefix": "bb/"
  },
  "completedTurns": {
    "pi": "flat",
    "acp-cursor": "flat",
    "claude-code": "collapse"
  },
  "experiments": {
    "changelogPreview": false,
    "legacyJitiPluginLoader": false,
    "mobileApp": false,
    "serverMove": false,
    "sidebarProgressiveDisclosure": false
  },
  "ui": {
    "sidebar.organizationMode": "chronological",
    "sidebar.threadGrouping.environment": "auto",
    "sidebar.chronologicalSort": "updated",
    "sidebar.sortDirection": "default",
    "sidebar.sectionOrder": [
      "pinned",
      "projects",
      "threads"
    ],
    "sidebar.manualSectionOrder": [
      "pinned",
      "sections",
      "threads"
    ],
    "sidebar.machineSectionOrder": [
      "pinned",
      "machines",
      "threads"
    ],
    "sidebar.footerOrder": [],
    "sidebar.hiddenFooterItems": [
      "builtin:report-bug",
      "plugin:provider-usage/usage"
    ],
    "sidebar.pluginPanelOrder": [
      "__bb__/new-thread",
      "__bb__/search-threads",
      "__bb__/extensions",
      "__bb__/skills",
      "__bb__/automations"
    ],
    "sidebar.visiblePluginPanels": [
      "__bb__/new-thread",
      "__bb__/extensions",
      "__bb__/skills",
      "__bb__/automations",
      "__bb__/search-threads"
    ],
    "sidebar.navigationProvider": "__automatic__",
    "sidebar.headerProvider": "__builtin__",
    "sidebar.threadListProvider": "__automatic__"
  },
  "keyboardOverrides": [
    {
      "command": "panel.toggle",
